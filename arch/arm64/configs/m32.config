# device-specific config. Don't touch this too much, edit mt6768_slm_defconfig for modification.
CONFIG_LOCALVERSION="-vigus-slmkernel-m32"
CONFIG_IS_M32_OR_F22=y
CONFIG_FAULT_AROUND_4KB=y
CONFIG_KSWAPD_CPU=0
CONFIG_ARCH_MTK_PROJECT="k69v1_64_titan_marmot"
CONFIG_HAVE_MOD_ARCH_SPECIFIC=y
CONFIG_ARCH_HAS_RELR=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_CLEANCACHE=y
CONFIG_RBIN=y
CONFIG_HIGHATOMIC_PAGEBLOCKS=0
CONFIG_ARM64_MODULE_CMODEL_LARGE=y
CONFIG_ARM64_MODULE_PLTS=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_MODULE_REGION_FULL=y
CONFIG_CMDLINE="console=tty0 console=ttyMT3,921600n1 root=/dev/ram vmalloc=496M slub_max_order=0 slub_debug=O "
CONFIG_NF_LOG_COMMON=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_SAMSUNG_NFC=y
CONFIG_NFC_PN547=y
CONFIG_NFC_FEATURE_SN100U=y
CONFIG_SEC_NFC_LOGGER=y
CONFIG_SEC_NFC_WAKELOCK_METHOD=0
CONFIG_CUSTOM_KERNEL_IMGSENSOR="s5kgw3_mipi_raw hi2021q_mipi_raw sr846d_mipi_raw gc5035_mipi_raw gc5035b_mipi_raw imx355_mipi_raw gc02m1b_mipi_raw gc02m1_mipi_raw"
CONFIG_CAMERA_MMU_V32=y
CONFIG_CAMERA_SAMSUNG_MODEL_NAME="mmu_v32"
CONFIG_CAMERA_SENSOR0="s5kgw3_mipi_raw"
CONFIG_CAMERA_SENSOR1="hi2021q_mipi_raw"
CONFIG_CAMERA_SENSOR2="imx355_mipi_raw"
CONFIG_CAMERA_SENSOR3="gc02m1b_mipi_raw"
CONFIG_CAMERA_SENSOR4="gc02m1_mipi_raw"
CONFIG_CAMERA_ADAPTIVE_MIPI=y
CONFIG_SMCDSD_DYNAMIC_MIPI=y
CONFIG_SMCDSD_PANEL_M32=y
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_LCM_HEIGHT="2400"
