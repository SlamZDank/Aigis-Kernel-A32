+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 6, 0)
+static int exfat_remount(struct super_block *sb, int *flags, char *data)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 0, 0)
+	*flags |= SB_NODIRATIME;
+#else
+	*flags |= MS_NODIRATIME;
+#endif
+
+	sync_filesystem(sb);
+	return 0;
+}
+#endif
