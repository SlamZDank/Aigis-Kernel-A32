+		struct inode *inode = file_inode(vma->vm_file);
+		if (SUSFS_IS_INODE_SUS_MAP(inode)) {
+			memset(&mss, 0, sizeof(mss));
+			goto bypass_orig_flow;
+		}
+	}
+#endif
 		smap_gather_stats(vma, &mss);
